# Copy to backend/.env and adjust. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://vehicle_damage:CHANGE_ME@localhost:5432/vehicle_damage

# For tests, export TEST_DATABASE_URL in your shell (a separate, disposable database).

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

# Root directory for uploaded images. Relative paths resolve from backend/.
STORAGE_ROOT=../storage/inspections

# Upload limits (enforced by the server). Mirror them in frontend/.env.
MAX_UPLOAD_BYTES=15728640
MAX_IMAGES_PER_INSPECTION=20
MIN_IMAGE_SIDE_PX=32
MAX_IMAGE_PIXELS=40000000

# Damage detection (local inference only; disabled by default).
# DETECTOR_BACKEND=ultralytics needs `pip install -e ".[detection]"` (AGPL-3.0) and a
# local YOLO detection weights file. Weights (.pt) are pickles: only use files from a
# source you trust, since loading one can execute code.
DETECTOR_BACKEND=none
# DETECTOR_WEIGHTS_PATH=../models/damage-detector.pt
# DETECTOR_MODEL_NAME=
# DETECTOR_MODEL_VERSION=
DETECTOR_CONFIDENCE_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
DETECTOR_IMAGE_SIZE=640
DETECTOR_MAX_DETECTIONS=100
DETECTOR_DEVICE=cpu

# VLM_BACKEND=transformers needs `pip install -e ".[vlm]"` and a LOCAL Qwen2-VL /
# Qwen2.5-VL snapshot directory (safetensors only; nothing is downloaded at runtime).
# Pin it with VLM_WEIGHTS_SHA256 = app.services.vlm.transformers_runner.model_dir_digest(dir).
VLM_BACKEND=none
# VLM_MODEL_PATH=../models/Qwen2-VL-2B-Instruct
# VLM_MODEL_NAME=qwen2-vl-2b-instruct
# VLM_MODEL_VERSION=
# VLM_WEIGHTS_SHA256=
VLM_DEVICE=cpu
VLM_DTYPE=bfloat16
VLM_TIMEOUT_SECONDS=180
