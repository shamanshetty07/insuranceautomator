# Copy to frontend/.env. Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000
# Client-side image limits (fast feedback only; the server enforces its own).
# Keep in sync with MAX_UPLOAD_BYTES / MAX_IMAGES_PER_INSPECTION in backend/.env.
VITE_MAX_IMAGE_BYTES=15728640
VITE_MAX_IMAGES_PER_INSPECTION=20
